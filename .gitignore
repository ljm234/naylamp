# Binaries and build output
*.exe
*.test
*.out
bin/
dist/
# A bare `go build ./cmd/naylampd` drops the daemon in the cwd; real gate builds
# target the ignored gate/out/. Anchored so it never matches the source packages
# engine/cmd/naylampd or engine/naylamp.
/naylampd
/engine/naylampd

# Go
/vendor/
go.work.sum

# Node
node_modules/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Env / secrets
.env
.env.local
*.pem

# Run artifacts: whatever a benchmark, sweep or gate writes into the tree. These are
# patterns rather than one line per file, so adding a benchmark or a gate does not
# mean editing this list again; name the output <something>_result.txt,
# <something>_bench.txt, or NAYLAMP_<NAME>_GATE<...>.txt and it is ignored already.
# The scripts and READMEs that PRODUCE these are committed; only their output is not.
engine/**/*_result.txt
engine/**/*_bench.txt
/NAYLAMP_*GATE*.txt
gate/out/

# Benchmark datasets, which live outside the repo
*.fvecs
*.ivecs

.claude/
